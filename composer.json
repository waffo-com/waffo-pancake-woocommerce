{
    "name": "waffo/waffo-pancake-woocommerce",
    "description": "Waffo Pancake payment gateway for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WaffoPancake\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaffoPancake\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
